page {
  height: 100%;
  background: #FFF6E5;
  color: #4A2E17;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  overflow: hidden;
}

view,
text,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  line-height: normal;
}

button::after {
  border: none;
}
